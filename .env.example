# Copia a .env y exporta estas variables antes de ejecutar el servidor.
# Solo se crea un usuario administrador si la base de datos aún no tiene uno.
ADMIN_EMAIL=
ADMIN_PASSWORD=
API_PORT=3001
# Solo desarrollo local: muestra el código de recuperación en la pantalla
DEV_SHOW_RESET_CODE=0
# Para uso detrás de HTTPS y proxy correctamente configurado
SECURE_COOKIES=0
